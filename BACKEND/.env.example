# Manager (backend) configuration — FORGE Phase 1
# Copy to BACKEND/.env (gitignored) and adjust as needed.
# Load with: node --env-file=.env dist/index.js   (or export the vars in your shell)

# Port the manager listens on. Default: 4242
PORT=4242

# Bind address. 127.0.0.1 = localhost only (local personal tool). Default: 127.0.0.1
HOST=127.0.0.1

# SQLite database file location.
# Leave empty for the default: BACKEND/runtime/control-center-v2.sqlite
# Windows note: journal mode auto-switches to TRUNCATE on win32.
MANAGER_DB_PATH=
