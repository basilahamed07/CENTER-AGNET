# Frontend (Next.js) configuration — FORGE Phase 1
# Copy to FRONETEND/.env.local (gitignored) and adjust as needed.
#
# URL of the local manager backend. Must match the manager's HOST:PORT.
# NEXT_PUBLIC_ vars are inlined at BUILD time in Next.js — set this before
# `npm run dev` / `npm run build`. Default if unset: http://127.0.0.1:4242
NEXT_PUBLIC_MANAGER_URL=http://127.0.0.1:4242
